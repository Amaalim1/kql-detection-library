// Detection: Brute Force / Password Spray Against Entra ID
// MITRE ATT&CK: T1110 (Brute Force) / T1110.003 (Password Spraying)
// Log source: Microsoft Sentinel — SigninLogs
//
// What it detects:
//   Accounts with a high volume of failed sign-ins from a small number of
//   source IPs within a short window, followed by at least one success —
//   the classic spray-then-land pattern.
//
// Why it matters:
//   Password spraying is one of the most common initial access techniques
//   against Entra ID because it avoids account lockout thresholds by
//   spreading attempts across many accounts. Catching the failed-attempt
//   spike before the successful login is the difference between an alert
//   and an incident.
//
// False positive considerations:
//   - Shared service accounts or break-glass accounts with legitimately
//     high failure rates (misconfigured scripts) will trigger this.
//   - VPN/proxy egress IPs shared across many legitimate users can inflate
//     the "distinct accounts per IP" count. Baseline your corporate egress
//     IP ranges and exclude them.
//   - Tune FailureThreshold and TimeWindow to your environment's auth
//     volume before enabling as a high-severity alert.

let TimeWindow = 1h;
let FailureThreshold = 10;
SigninLogs
| where TimeGenerated > ago(TimeWindow)
| where ResultType != "0" // non-zero = failed sign-in
| summarize
    FailedAttempts = count(),
    DistinctAccounts = dcount(UserPrincipalName),
    TargetedAccounts = make_set(UserPrincipalName, 20)
    by IPAddress, bin(TimeGenerated, TimeWindow)
| where FailedAttempts >= FailureThreshold and DistinctAccounts >= 5
| join kind=inner (
    SigninLogs
    | where TimeGenerated > ago(TimeWindow)
    | where ResultType == "0" // successful sign-in
    | project SuccessTime = TimeGenerated, SuccessUser = UserPrincipalName, IPAddress
) on IPAddress
| project TimeGenerated, IPAddress, FailedAttempts, DistinctAccounts, TargetedAccounts, SuccessUser, SuccessTime
| order by FailedAttempts desc
