// Detection: LSASS Memory Access (Credential Dumping)
// MITRE ATT&CK: T1003.001 (OS Credential Dumping: LSASS Memory)
// Log source: Microsoft Defender XDR — DeviceProcessEvents
//
// What it detects:
//   Known credential-dumping tools and living-off-the-land binaries
//   (procdump, comsvcs.dll MiniDump export, rundll32 abuse, taskmgr
//   memory dump) being used to access LSASS process memory.
//
// Why it matters:
//   LSASS holds cached credentials, Kerberos tickets, and NTLM hashes.
//   Dumping it is a near-universal step between initial foothold and
//   lateral movement / domain compromise. This is one of the
//   highest-value single detections a SOC can have.
//
// False positive considerations:
//   - EDR/AV vendors and legitimate backup/monitoring agents sometimes
//     touch LSASS for benign reasons — allowlist known security tooling
//     by signed process path/hash.
//   - IT staff troubleshooting with Task Manager "Create dump file" on
//     lsass.exe is rare but legitimate; verify with the user before
//     escalating.
//   - Procdump used against other processes (not lsass.exe) is common
//     for legitimate app troubleshooting — this query filters on target
//     process name to reduce that noise.

DeviceProcessEvents
| where Timestamp > ago(1d)
| where (
    // procdump targeting lsass
    (FileName =~ "procdump.exe" or FileName =~ "procdump64.exe")
    and ProcessCommandLine has "lsass"
)
or (
    // comsvcs.dll MiniDump technique via rundll32
    FileName =~ "rundll32.exe"
    and ProcessCommandLine has "comsvcs.dll"
    and ProcessCommandLine has "MiniDump"
)
or (
    // direct handle access to lsass by an unusual parent process
    ProcessCommandLine has "lsass.exe" and FileName =~ "taskmgr.exe"
)
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine,
    InitiatingProcessFileName, InitiatingProcessAccountName, InitiatingProcessCommandLine
| order by Timestamp desc
